         b.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
         task.delay(0.2, function() b.BackgroundColor3 = Color3.fromRGB(25, 25, 25) end)
         callback()
      end)
   end
   
   addButton("Auto Go To Base [TP]", function()
      local char = LocalPlayer.Character
      if char and char:FindFirstChild("HumanoidRootPart") then
         for _, obj in ipairs(Workspace:GetDescendants()) do
            if (obj.Name:lower():find("base") or obj.Name:lower():find("plot")) and obj:IsA("Model") and obj.PrimaryPart then
               char.HumanoidRootPart.CFrame = obj.PrimaryPart.CFrame + Vector3.new(0, 5, 0)
               break
            end
         end
      end
   end)
   
   addButton("Server Hop [MUDAR]", function()
      pcall(function()
         local response = game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/public?sortOrder=Asc&limit=10")
         local servers = HttpService:JSONDecode(response)
         for _, s in ipairs(servers.data) do
            if s.id ~= game.JobId then
               TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
               break
            end
         end
      end)
   end)
end

