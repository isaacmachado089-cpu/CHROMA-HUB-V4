local function loadPlayerTab()
   clearContent()
   local scroller = Instance.new("ScrollingFrame", ContentArea)
   scroller.Size = UDim2.new(1, 0, 1, 0)
   scroller.BackgroundTransparency = 1
   scroller.CanvasSize = UDim2.new(0, 0, 0, 220)
   scroller.ScrollBarThickness = 3
   
   local list = Instance.new("UIListLayout", scroller)
   list.Padding = UDim.new(0, 6)
   
   local function addToggle(text, getState, setState)
      local b = Instance.new("TextButton", scroller)
      b.Size = UDim2.new(1, -6, 0, 36)
      b.BackgroundColor3 = getState() and Color3.fromRGB(200, 30, 30) or Color3.fromRGB(22, 22, 22)
      b.TextColor3 = Color3.fromRGB(255, 255, 255)
      b.Font = Enum.Font.GothamMedium
      b.TextSize = 10
      
      local corner = Instance.new("UICorner", b)
      corner.CornerRadius = UDim.new(0, 6)
      
      local function updateState()
         local active = getState()
         b.Text = text .. ": [ " .. (active and "ON" or "OFF") .. " ]"
         b.BackgroundColor3 = active and Color3.fromRGB(200, 30, 30) or Color3.fromRGB(22, 22, 22)
      end
      updateState()
      
      b.MouseButton1Click:Connect(function()
         setState(not getState())
         updateState()
      end)
   end
   
   addToggle("Infinite Jump", function() return infJumpOn end, function(v) infJumpOn = v end)
   addToggle("Fly (Modo Voo Otimizado)", function() return flyOn end, function(v) flyOn = v end)
   addToggle("Anti Ragdoll", function() return antiRagdollOn end, function(v) antiRagdollOn = v end)
end

